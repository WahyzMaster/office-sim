{
  "name": "office-sim",
  "version": "0.1.0",
  "description": "Local 3D office visualizer for AI coding agents — tails Claude Code, Codex, Grok (xAI Grok Build), and Antigravity session logs in real time with zero dependencies.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "office-sim": "bin/office-sim.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "skills/",
    "scripts/",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WahyzMaster/office-sim.git"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "grok",
    "antigravity",
    "threejs",
    "visualizer",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/office-sim.mjs",
    "test": "node --test test/*.test.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "skill:uninstall": "node scripts/install-skill.mjs --uninstall"
  }
}
