{
  "name": "office-sim",
  "version": "0.2.0",
  "description": "Local 3D office visualizer for AI coding agents — tails Claude Code, Codex, Grok (xAI Grok Build), and Antigravity session logs in real time with zero dependencies.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://wahyzmaster.github.io/office-sim/?lang=en#demo",
  "bugs": {
    "url": "https://github.com/WahyzMaster/office-sim/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/WahyzMaster"
    },
    {
      "type": "polar",
      "url": "https://polar.sh/WahyzMaster"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/wahyzdad"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "office-sim": "bin/office-sim.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "skills/",
    "scripts/install-skill.mjs",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WahyzMaster/office-sim.git"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "grok",
    "antigravity",
    "threejs",
    "visualizer",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/office-sim.mjs",
    "test": "node --test test/*.test.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "skill:uninstall": "node scripts/install-skill.mjs --uninstall"
  }
}
